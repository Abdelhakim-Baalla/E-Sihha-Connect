Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
    "patient": "{{patientId}}",
    "consultation": "",
    "tests": [
        {
            "code": "HB1",
            "nom": "Hémogramme complet",
            "instructions": "À jeun",
